VITE_API_BASE_URL=http://localhost:8000/api/v1

# Pusher app key + cluster are public/non-secret by design (safe to ship
# in frontend code) — get them from the same Pusher app you configured
# on the backend (crm_assurance/.env PUSHER_APP_KEY / PUSHER_APP_CLUSTER).
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
